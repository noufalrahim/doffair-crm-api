# ==============================================================================
# ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and update with your actual values

# Application
ENVIRONMENT=development
DEBUG=true
JWT_SECRET_KEY=your-secure-random-jwt-secret-key-here

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI_SECONDARY=mongodb+srv://doffair_dev:yTwgZQf2t3XiSXos@development-cluster.9w53x.mongodb.net/?retryWrites=true&w=majority&appName=development-cluster
MONGODB_DB_NAME=doffair_vendors
MONGODB_DB_NAME_SECONDARY=doffair_dev

# CORS
ALLOWED_ORIGINS=["http://localhost:4200","http://localhost:3000"]

# Redis (Required for Notifications)
# Use 127.0.0.1 instead of localhost for better Windows/Docker compatibility
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_QUEUE_NAME=doffair:notifications

# Email Notifications (Leave empty for mock mode)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@doffair.com
SMTP_FROM_NAME=Doffair

# SMS Notifications (Leave as placeholder for mock mode)
SMS_PROVIDER=2FACTOR
TWOFACTOR_API_KEY=your_api_key_here
TWOFACTOR_OTP_TEMPLATE=DOFFAIR_OTP

# WhatsApp Notifications (Leave empty for mock mode)
WHATSAPP_ACCOUNT_SID=
WHATSAPP_AUTH_TOKEN=
WHATSAPP_FROM_NUMBER=

# Notification Settings
NOTIFICATION_RETRY_MAX=3
NOTIFICATION_RETRY_DELAY=60

# Azure Blob Storage
AZURE_BLOB_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=your-account;AccountKey=your-key;EndpointSuffix=core.windows.net"
AZURE_BLOB_CONTAINER=doffair-assets
AZURE_CDN_BASE_URL=https://your-cdn-url.azurefd.net
